<Application x:Class="FUREQ.Workspace.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="WorkspaceBackground" Color="#F4F6F8" />
        <SolidColorBrush x:Key="WorkspaceInk" Color="#17212B" />
        <SolidColorBrush x:Key="WorkspaceAccent" Color="#0B6E69" />
    </Application.Resources>
</Application>

<Window x:Class="FUREQ.Workspace.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FUREQ Workspace" Height="680" Width="1080"
        MinHeight="540" MinWidth="820"
        Background="{StaticResource WorkspaceBackground}"
        Foreground="{StaticResource WorkspaceInk}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#122526" Padding="18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="4,8,4,28">
                    <TextBlock Text="FUREQ" Foreground="#C6E5E0" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="Workspace" Foreground="White" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding NavigationItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Title}" Command="{Binding NavigateCommand}"
                                    CommandParameter="{Binding Key}" HorizontalContentAlignment="Left"
                                    Padding="12,10" Margin="0,2" BorderThickness="0"
                                    Background="Transparent" Foreground="#E5EFED" FontSize="14" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock DockPanel.Dock="Bottom" Text="FUREQ-DEVELOP · GitHub API" Foreground="#A9BFBC"
                           FontSize="11" Margin="4,24,4,4" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,34" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="{Binding CurrentTitle}" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="{Binding CurrentDescription}" FontSize="14" Foreground="#55636C"
                           TextWrapping="Wrap" Margin="0,10,0,24" />
                <Border Background="White" BorderBrush="#D9E1E5" BorderThickness="1" CornerRadius="8" Padding="22">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentKey}" Value="repositories">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentKey}" Value="setup">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentKey}" Value="documents">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentKey}" Value="assets">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="準備中" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource WorkspaceAccent}" />
                        <TextBlock Text="この領域に機能を追加します。現在はアプリの基盤を構築しています。"
                                   FontSize="15" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding DatabaseStatus}" FontSize="12" Foreground="#65747D" Margin="0,18,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#D9E1E5" BorderThickness="1" CornerRadius="8" Padding="22">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentKey}" Value="setup">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="プロファイルを作成" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="保存先の設定だけを記録します。フォルダーの作成やファイル変更は行いません。"
                                   Foreground="#55636C" TextWrapping="Wrap" Margin="0,6,0,14" />
                        <TextBlock Text="名前" FontWeight="SemiBold" />
                        <TextBox Text="{Binding WorkspaceName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" Padding="8" />
                        <TextBlock Text="班・職種" FontWeight="SemiBold" />
                        <TextBox Text="{Binding WorkspaceRole, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" Padding="8" />
                        <TextBlock Text="保存先フォルダー" FontWeight="SemiBold" />
                        <DockPanel Margin="0,4,0,12">
                            <Button DockPanel.Dock="Right" Content="参照…" Command="{Binding BrowseWorkspaceRootCommand}"
                                    Margin="8,0,0,0" Padding="12,6" />
                            <TextBox Text="{Binding WorkspaceRootPath, UpdateSourceTrigger=PropertyChanged}" Padding="8" />
                        </DockPanel>
                        <Button Content="プロファイルを保存" Command="{Binding CreateWorkspaceProfileCommand}"
                                HorizontalAlignment="Left" Padding="14,8" />
                        <TextBlock Text="登録済みプロファイル" FontSize="17" FontWeight="SemiBold" Margin="0,18,0,6" />
                        <ListBox ItemsSource="{Binding WorkspaceProfiles}" SelectedItem="{Binding SelectedWorkspaceProfile}"
                                 DisplayMemberPath="Name" MinHeight="60" MaxHeight="150" />
                        <TextBlock Text="Workspace Setup" FontSize="17" FontWeight="SemiBold" Margin="0,18,0,6" />
                        <DockPanel Margin="0,4,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="モード" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox ItemsSource="{Binding SetupModes}" SelectedItem="{Binding SelectedSetupMode}" Padding="6" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="LFS" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox ItemsSource="{Binding LfsModes}" SelectedItem="{Binding SelectedLfsMode}" Padding="6" />
                        </DockPanel>
                        <TextBox Text="{Binding CustomRepositoryNames, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Custom mode: リポジトリ名を改行またはカンマ区切りで入力" Padding="8" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Setup Planを作成" Command="{Binding CreateSetupPlanCommand}" Padding="14,8" />
                            <Button Content="前回の計画を再開" Command="{Binding ResumeSetupPlanCommand}" Margin="8,0,0,0" Padding="14,8" />
                            <Button Content="計画を実行" Command="{Binding ExecuteSetupPlanCommand}"
                                    Margin="8,0,0,0" Padding="14,8" />
                            <Button Content="キャンセル" Command="{Binding CancelSetupCommand}" IsEnabled="{Binding IsSetupRunning}"
                                    Margin="8,0,0,0" Padding="14,8" />
                        </StackPanel>
                        <TextBlock Text="{Binding SetupStatusText}" Foreground="#55636C" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding SetupItems}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  MinHeight="100" MaxHeight="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="状態" Binding="{Binding State}" Width="90" />
                                <DataGridTextColumn Header="リポジトリ" Binding="{Binding FullName}" Width="2*" />
                                <DataGridTextColumn Header="保存先" Binding="{Binding RelativePath}" Width="2*" />
                                <DataGridTextColumn Header="依存" Binding="{Binding Dependencies.Count}" Width="60" />
                                <DataGridTextColumn Header="メモ" Binding="{Binding Message}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Content="ローカルリポジトリを確認" Command="{Binding ScanLocalRepositoriesCommand}"
                                HorizontalAlignment="Left" Padding="14,8" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding RepositoryStatus}" Foreground="#55636C" Margin="0,8,0,8" />
                        <DataGrid ItemsSource="{Binding LocalRepositories}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  SelectedItem="{Binding SelectedLocalRepository}"
                                  MinHeight="100" MaxHeight="280">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="フォルダー" Binding="{Binding DirectoryName}" Width="*" />
                                <DataGridCheckBoxColumn Header="現在あり" Binding="{Binding IsPresent}" Width="80" />
                                <DataGridTextColumn Header="パス" Binding="{Binding Path}" Width="3*" />
                                <DataGridTextColumn Header="確認日時" Binding="{Binding LastScannedAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Git操作" FontSize="17" FontWeight="SemiBold" Margin="0,20,0,8" />
                        <Button Content="Git状態を確認" Command="{Binding GetGitStatusCommand}"
                                HorizontalAlignment="Left" Padding="14,8" />
                        <TextBlock Text="{Binding GitStatusText}" Foreground="#55636C" TextWrapping="Wrap" Margin="0,8" />
                        <ListBox ItemsSource="{Binding GitChangedPaths}" MaxHeight="100" />
                        <DockPanel Margin="0,10,0,8">
                            <Button DockPanel.Dock="Right" Content="ブランチ作成" Command="{Binding CreateBranchCommand}"
                                    Margin="8,0,0,0" Padding="12,6" />
                            <TextBox Text="{Binding NewBranchName, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="例: feature/my-change" Padding="8" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Fetch" Command="{Binding FetchCommand}" Padding="14,8" />
                            <Button Content="Fast-forward Pull" Command="{Binding PullFastForwardCommand}"
                                    Margin="8,0,0,0" Padding="14,8" />
                            <Button Content="Push" Command="{Binding PushCommand}" Margin="8,0,0,0" Padding="14,8" />
                        </StackPanel>
                        <TextBlock Text="コミット（変更はGitHub Desktop等で先にステージ）" FontWeight="SemiBold" Margin="0,8,0,4" />
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="ステージ済みをコミット"
                                    Command="{Binding CommitStagedChangesCommand}" Margin="8,0,0,0" Padding="12,6" />
                            <TextBox Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="1行、200文字以内" Padding="8" />
                        </DockPanel>
                        <TextBlock Text="Pull Request" FontWeight="SemiBold" Margin="0,8,0,4" />
                        <TextBox Text="{Binding PullRequestTitle, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="タイトル" Padding="8" Margin="0,0,0,6" />
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Text="Base:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding PullRequestBase, UpdateSourceTrigger=PropertyChanged}" Padding="8" />
                        </DockPanel>
                        <TextBox Text="{Binding PullRequestBody, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="PR本文" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" Padding="8" />
                        <Button Content="GitHubにPull Requestを作成" Command="{Binding CreatePullRequestCommand}"
                                HorizontalAlignment="Left" Padding="14,8" Margin="0,8,0,0" />
                        <TextBlock Text="Submodule graph" FontSize="17" FontWeight="SemiBold" Margin="0,20,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="依存と記録SHAを確認" Command="{Binding LoadSubmodulesCommand}" Padding="14,8" />
                            <Button Content="未初期化を再帰初期化" Command="{Binding InitializeSubmodulesCommand}"
                                    Margin="8,0,0,0" Padding="14,8" />
                        </StackPanel>
                        <TextBlock Text="{Binding SubmoduleStatusText}" Foreground="#55636C" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <DataGrid ItemsSource="{Binding Submodules}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  MinHeight="70" MaxHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="相対パス" Binding="{Binding RelativePath}" Width="2*" />
                                <DataGridTextColumn Header="リポジトリ" Binding="{Binding RepositoryFullName}" Width="2*" />
                                <DataGridTextColumn Header="記録SHA" Binding="{Binding PinnedCommit}" Width="2*" />
                                <DataGridCheckBoxColumn Header="初期化済み" Binding="{Binding IsInitialized}" Width="90" />
                                <DataGridCheckBoxColumn Header="SHA不一致" Binding="{Binding NeedsPinnedUpdate}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#D9E1E5" BorderThickness="1" CornerRadius="8" Padding="22">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentKey}" Value="documents">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="ローカルMarkdown" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="選択中のローカルリポジトリ内だけを検索します。HTML/スクリプト/外部画像は描画せず、Markdownソースとして表示します。"
                                   Foreground="#55636C" TextWrapping="Wrap" Margin="0,6,0,10" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Markdown一覧" Command="{Binding LoadMarkdownDocumentsCommand}" Padding="14,8" />
                            <TextBox Text="{Binding MarkdownSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="本文を検索" Padding="8" Width="260" Margin="8,0,0,0" />
                            <Button Content="検索" Command="{Binding SearchMarkdownCommand}" Margin="8,0,0,0" Padding="14,8" />
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding MarkdownDocuments}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  MinHeight="80" MaxHeight="170">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="相対パス" Binding="{Binding RelativePath}" Width="3*" />
                                <DataGridTextColumn Header="サイズ" Binding="{Binding Length}" Width="100" />
                                <DataGridTextColumn Header="更新" Binding="{Binding LastModifiedUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="150" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <DockPanel Margin="0,8,0,8">
                            <Button DockPanel.Dock="Right" Content="開く" Command="{Binding OpenMarkdownCommand}" Margin="8,0,0,0" Padding="14,8" />
                            <TextBox Text="{Binding MarkdownRelativePath, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="相対 .md パス。例: README.md" Padding="8" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Issueテンプレート" Command="{Binding InsertMarkdownTemplateCommand}"
                                    CommandParameter="issue" Padding="12,6" />
                            <Button Content="会議テンプレート" Command="{Binding InsertMarkdownTemplateCommand}"
                                    CommandParameter="meeting" Margin="8,0,0,0" Padding="12,6" />
                            <Button Content="設計テンプレート" Command="{Binding InsertMarkdownTemplateCommand}"
                                    CommandParameter="design" Margin="8,0,0,0" Padding="12,6" />
                            <Button Content="保存" Command="{Binding SaveMarkdownCommand}" Margin="8,0,0,0" Padding="14,6" />
                        </StackPanel>
                        <TextBox Text="{Binding MarkdownContent, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="13" MinHeight="280" Padding="10" />
                        <DataGrid ItemsSource="{Binding MarkdownSearchResults}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  MinHeight="70" MaxHeight="160" Margin="0,8,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="パス" Binding="{Binding RelativePath}" Width="2*" />
                                <DataGridTextColumn Header="行" Binding="{Binding LineNumber}" Width="60" />
                                <DataGridTextColumn Header="内容" Binding="{Binding Preview}" Width="3*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{Binding MarkdownStatusText}" Foreground="#55636C" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#D9E1E5" BorderThickness="1" CornerRadius="8" Padding="22">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentKey}" Value="assets">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="ローカル資産・LFS状態" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="このリポジトリに既にあるファイルだけを一覧します。画像thumbnailやLFS objectを自動取得しません。"
                                   Foreground="#55636C" TextWrapping="Wrap" Margin="0,6,0,10" />
                        <Button Content="資産一覧を更新" Command="{Binding LoadAssetsCommand}" HorizontalAlignment="Left" Padding="14,8" />
                        <TextBlock Text="{Binding AssetStatusText}" Foreground="#55636C" TextWrapping="Wrap" Margin="0,8,0,8" />
                        <DataGrid ItemsSource="{Binding Assets}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  MinHeight="100" MaxHeight="300">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="相対パス" Binding="{Binding RelativePath}" Width="3*" />
                                <DataGridTextColumn Header="種類" Binding="{Binding Extension}" Width="80" />
                                <DataGridTextColumn Header="サイズ" Binding="{Binding Length}" Width="100" />
                                <DataGridCheckBoxColumn Header="画像" Binding="{Binding IsImage}" Width="60" />
                                <DataGridCheckBoxColumn Header="LFS pointer" Binding="{Binding IsGitLfsPointer}" Width="90" />
                                <DataGridTextColumn Header="LFS object ID" Binding="{Binding LfsObjectId}" Width="2*" />
                                <DataGridTextColumn Header="LFS bytes" Binding="{Binding LfsObjectSize}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="資産依頼をIssueで作成" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,8" />
                        <TextBox Text="{Binding AssetRequestTitle, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Issueを作成する対象リポジトリを上のリポジトリ一覧で選択" Padding="8" Margin="0,0,0,6" />
                        <TextBox Text="{Binding AssetRequestDetails, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" Padding="8" Margin="0,0,0,8" />
                        <Button Content="確認して資産依頼Issueを作成" Command="{Binding CreateAssetRequestCommand}"
                                HorizontalAlignment="Left" Padding="14,8" />
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#D9E1E5" BorderThickness="1" CornerRadius="8"
                        Padding="22">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentKey}" Value="repositories">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding AuthenticationStatus}" Margin="0,0,0,10" Foreground="#55636C" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="GitHubでサインイン" Command="{Binding SignInCommand}" Padding="14,8" />
                            <Button Content="この端末からサインアウト" Command="{Binding SignOutCommand}"
                                    Padding="14,8" Margin="8,0,0,0" />
                            <Button Content="認証をキャンセル" Command="{Binding CancelSignInCommand}"
                                    Padding="14,8" Margin="8,0,0,0" />
                        </StackPanel>
                        <Button Content="リポジトリを更新" Command="{Binding LoadRepositoriesCommand}"
                                HorizontalAlignment="Left" Padding="14,8" />
                        <TextBlock Text="{Binding RepositoryStatus}" Margin="0,12,0,8" Foreground="#55636C" />
                        <DataGrid ItemsSource="{Binding Repositories}" SelectedItem="{Binding SelectedRepository}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  MinHeight="120" MaxHeight="440">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="リポジトリ" Binding="{Binding FullName}" Width="2*" />
                                <DataGridTextColumn Header="説明" Binding="{Binding Description}" Width="3*" />
                                <DataGridCheckBoxColumn Header="Archived" Binding="{Binding Archived}" Width="90" />
                                <DataGridTextColumn Header="公開範囲" Binding="{Binding Visibility}" Width="90" />
                                <DataGridTextColumn Header="更新" Binding="{Binding UpdatedAt, StringFormat={}{0:yyyy-MM-dd}}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="所属チーム" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,8" />
                        <DataGrid ItemsSource="{Binding Teams}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  MinHeight="70" MaxHeight="180">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="チーム" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="識別子" Binding="{Binding Slug}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Issues" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Issueを読み込む" Command="{Binding LoadIssuesCommand}" Padding="14,8" />
                            <Button Content="PRを読み込む" Command="{Binding LoadPullRequestsCommand}" Margin="8,0,0,0" Padding="14,8" />
                        </StackPanel>
                        <TextBox Text="{Binding IssueTitle, UpdateSourceTrigger=PropertyChanged}" ToolTip="Issueタイトル"
                                 Padding="8" Margin="0,0,0,6" />
                        <TextBox Text="{Binding IssueBody, UpdateSourceTrigger=PropertyChanged}" ToolTip="Issue本文"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Padding="8" Margin="0,0,0,6" />
                        <Button Content="GitHubにIssueを作成" Command="{Binding CreateIssueCommand}"
                                HorizontalAlignment="Left" Padding="14,8" />
                        <DataGrid ItemsSource="{Binding Issues}" SelectedItem="{Binding SelectedIssue}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  MinHeight="80" MaxHeight="220" Margin="0,8,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="60" />
                                <DataGridTextColumn Header="タイトル" Binding="{Binding Title}" Width="2*" />
                                <DataGridTextColumn Header="状態" Binding="{Binding State}" Width="80" />
                                <DataGridTextColumn Header="作成者" Binding="{Binding Author}" Width="100" />
                                <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid ItemsSource="{Binding PullRequests}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  MinHeight="70" MaxHeight="180" Margin="0,8,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PR #" Binding="{Binding Number}" Width="60" />
                                <DataGridTextColumn Header="タイトル" Binding="{Binding Title}" Width="2*" />
                                <DataGridTextColumn Header="状態" Binding="{Binding State}" Width="80" />
                                <DataGridTextColumn Header="作成者" Binding="{Binding Author}" Width="100" />
                                <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Organization Projects v2" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Projectsを読み込む" Command="{Binding LoadProjectsCommand}" Padding="14,8" />
                            <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                                      DisplayMemberPath="Title" Width="260" Margin="8,0,0,0" Padding="6" />
                            <Button Content="項目を表示" Command="{Binding LoadProjectItemsCommand}" Margin="8,0,0,0" Padding="14,8" />
                            <Button Content="選択Issueを追加" Command="{Binding AddIssueToProjectCommand}" Margin="8,0,0,0" Padding="14,8" />
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding ProjectItems}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  MinHeight="70" MaxHeight="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="種類" Binding="{Binding ContentType}" Width="120" />
                                <DataGridTextColumn Header="タイトル" Binding="{Binding Title}" Width="2*" />
                                <DataGridTextColumn Header="状態" Binding="{Binding State}" Width="80" />
                                <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{Binding CollaborationStatusText}" Foreground="#55636C"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
